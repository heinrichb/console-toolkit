{
	"name": "@heinrichb/console-toolkit",
	"version": "1.0.0",
	"description": "A versatile TypeScript utility library for enhanced console logging, formatting, and layout management.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"demo": "bun run src/demo.ts",
		"test": "bun run build && bun test",
		"test:coverage": "bun run build && bun test --coverage --coverage-threshold=100",
		"build": "bun x tsc",
		"publish": "npm publish",
		"format:check": "prettier --check \"src/**/*.{ts,json,md}\"",
		"format:write": "prettier --write \"src/**/*.{ts,json,md}\"",
		"lint": "eslint \"src/**/*.ts\"",
		"tree": "tree -a -I '.git|node_modules|dist'"
	},
	"prettier": {
		"printWidth": 128,
		"tabWidth": 2,
		"trailingComma": "none",
		"bracketSameLine": true,
		"semi": true,
		"singleQuote": false,
		"useTabs": true
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"prettier": "^3.5.3",
		"typescript": "^5"
	}
}
